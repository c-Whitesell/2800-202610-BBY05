<%- include('components/header', { 
  title: 'Map',
  styles: `
    <link rel="stylesheet" href="/css/search.css" />
  `
  }) %>

<div class="page-wrapper">

    <main class="search-hero text-center">
        <div class="container">
            <div class="search-hero-bg">
            <h1 class="display-4 fw-bold mb-3">ShadyTrails</h1>
            </div>
            <div class="search-hero-content">
                <p class="lead mb-4">Find your next shaded trail adventure</p>
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="input-group input-group-lg">

                        <input
                            type="text"
                            id="searchPageInput"
                            class="form-control border-0 shadow-sm"
                            placeholder="What are you looking for?"
                        >

                        <button class="btn btn-search px-4 st-btn st-btn--primary st-btn--sm">
                            Search
                        </button>

                        <ul id="history" class="list-group shadow-sm"></ul>

                    </div>
                </div>
            </div>

            <div class="container my-5">
                <div id="searchResults" class="row justify-content-center">
                </div>
            </div>
        </div>
        </div>
    </main>
    
    <%- include('components/footer') %>

</div>