<%- include('components/header') %>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"
/>
<style>
  body { background: #f5f4f0; }

  .navbar { border-bottom: 1px solid #d3d1c7; background: #ffffff !important; }
  .navbar-brand {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #1a1a18 !important;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .navbar-brand::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #3b6d11;
    border-radius: 50%;
  }
  .nav-tabs { border: none; }
  .nav-tabs .nav-link {
    color: #888780;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  .nav-tabs .nav-link.active {
    color: #3b6d11;
    border-bottom: 2px solid #3b6d11;
    background: none;
    font-weight: 500;
  }
  .nav-tabs .nav-link:hover { color: #3b6d11; }

  .weather-page { max-width: 540px; margin: 2rem auto; }

  .location-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
  }
  .location-name { font-weight: 500; }
  .location-sub { color: #888780; font-size: 0.75rem; }
  .location-date { color: #b4b2a9; }
  .location-icon { color: #3b6d11; margin-right: 5px; }

  .hero-card {
    background: #ffffff;
    border: 1px solid #d3d1c7;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .condition-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3b6d11;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 4px;
  }
  .temp-display {
    font-family: Georgia, serif;
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    color: #1a1a18;
  }
  .temp-display sup { font-size: 1.25rem; vertical-align: top; margin-top: 10px; display: inline-block; }
  .feels-like { font-size: 0.8rem; color: #888780; margin-top: 6px; }

  .shade-ring-wrap { text-align: center; }
  .shade-ring {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid #c0dd97;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .shade-ring-num {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    color: #3b6d11;
    line-height: 1;
  }
  .shade-ring-lbl { font-size: 0.6rem; color: #888780; margin-top: 2px; }
  .shade-ring-caption { font-size: 0.7rem; color: #888780; margin-top: 6px; line-height: 1.4; }
  .shade-ring.shade-high { border-color: #c0dd97; }
  .shade-ring.shade-medium { border-color: #fac775; }
  .shade-ring.shade-low { border-color: #f5a0a0; }
  .shade-ring-num.shade-high { color: #3b6d11; }
  .shade-ring-num.shade-medium { color: #ba7517; }
  .shade-ring-num.shade-low { color: #aa2222; }

  .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 1.25rem; }
  .metric-card {
    background: #ffffff;
    border: 1px solid #d3d1c7;
    border-radius: 10px;
    padding: 0.75rem 0.5rem;
    text-align: center;
  }
  .metric-card i { font-size: 1.2rem; color: #888780; display: block; margin-bottom: 4px; }
  .metric-val { font-size: 0.875rem; font-weight: 500; color: #1a1a18; }
  .metric-lbl { font-size: 0.65rem; color: #888780; margin-top: 2px; }

  .section-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #888780;
    margin-bottom: 0.75rem;
  }

  .hourly-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    margin-bottom: 1.25rem;
  }
  .hourly-strip::-webkit-scrollbar { display: none; }
  .hour-card {
    min-width: 64px;
    background: #f1efe8;
    border: 1px solid #d3d1c7;
    border-radius: 10px;
    padding: 10px 6px;
    text-align: center;
    flex-shrink: 0;
  }
  .hour-card.now { background: #eaf3de; border-color: #639922; }
  .hour-time { font-size: 0.7rem; color: #888780; }
  .hour-card.now .hour-time { color: #3b6d11; font-weight: 600; }
  .hour-card i { font-size: 1.125rem; color: #888780; display: block; margin: 6px 0; }
  .hour-card.now i { color: #3b6d11; }
  .hour-temp { font-size: 0.875rem; font-weight: 500; }
  .hour-shade { font-size: 0.65rem; color: #888780; margin-top: 3px; }
  .hour-card.now .hour-shade { color: #3b6d11; font-weight: 600; }

  .shade-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    margin-bottom: 10px;
  }
  .shade-bar-label { color: #888780; min-width: 68px; }
  .shade-bar-track { flex: 1; height: 6px; background: #e8e6df; border-radius: 99px; overflow: hidden; }
  .shade-bar-fill { height: 100%; border-radius: 99px; }
  .shade-bar-pct { min-width: 34px; text-align: right; color: #888780; }

  .shade-alert {
    background: #faeeda;
    border: 1px solid #fac775;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
    color: #633806;
    line-height: 1.5;
  }
  .shade-alert i { color: #ba7517; font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
  .shade-alert strong { font-weight: 600; display: block; margin-bottom: 2px; color: #412402; }

  .trail-card {
    background: #ffffff;
    border: 1px solid #d3d1c7;
    border-radius: 12px;
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    transition: border-color 0.15s;
  }
  .trail-card:hover { border-color: #97c459; }
  .trail-icon {
    width: 40px;
    height: 40px;
    background: #eaf3de;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .trail-icon i { font-size: 1.2rem; color: #3b6d11; }
  .trail-info { flex: 1; }
  .trail-name { font-size: 0.9rem; font-weight: 500; color: #1a1a18; }
  .trail-meta { font-size: 0.75rem; color: #888780; margin-top: 2px; }
  .badge-shade-high { background: #eaf3de; color: #27500a; font-size: 0.7rem; padding: 3px 10px; border-radius: 99px; font-weight: 500; white-space: nowrap; }
  .badge-shade-med  { background: #faeeda; color: #633806; font-size: 0.7rem; padding: 3px 10px; border-radius: 99px; font-weight: 500; white-space: nowrap; }
  .badge-shade-low  { background: #fcebeb; color: #501313; font-size: 0.7rem; padding: 3px 10px; border-radius: 99px; font-weight: 500; white-space: nowrap; }

  #weather-loading { text-align: center; padding: 3rem 0; color: #888780; }
  #weather-error { display: none; text-align: center; padding: 2rem 0; color: #aa2222; }
  #weather-content { display: none; }

  @keyframes spin { to { transform: rotate(360deg); } }
  #weather-loading i { display: inline-block; animation: spin 1s linear infinite; }
</style>

<div class="container weather-page">

  <div id="weather-loading">
    <i class="ti ti-loader" style="font-size:2rem;"></i>
    <p class="mt-2">Checking shade conditions…</p>
  </div>

  <div id="weather-error">
    <i class="ti ti-alert-circle" style="font-size:2rem;"></i>
    <p class="mt-2">Could not load weather data. Please try again.</p>
    <button class="btn btn-sm btn-outline-secondary mt-2" onclick="fetchWeather()">Retry</button>
  </div>

  <div id="weather-content">

    <div class="location-bar">
      <div class="d-flex align-items-center">
        <i class="ti ti-map-pin location-icon"></i>
        <div>
          <div class="location-name" id="location-name">–</div>
          <div class="location-sub" id="location-sub">Detecting location…</div>
        </div>
      </div>
      <div class="location-date" id="location-date">–</div>
    </div>

    <div class="hero-card mb-3">
      <div>
        <div class="condition-label">
          <i id="condition-icon" class="ti ti-cloud-sun"></i>
          <span id="condition-text">–</span>
        </div>
        <div class="temp-display" id="temp-display">–<sup>°C</sup></div>
        <div class="feels-like" id="feels-like">–</div>
      </div>
      <div class="shade-ring-wrap">
        <div class="shade-ring shade-high" id="shade-ring">
          <div class="shade-ring-num shade-high" id="shade-score">–</div>
          <div class="shade-ring-lbl">shade</div>
        </div>
        <div class="shade-ring-caption" id="shade-caption">–</div>
      </div>
    </div>

    <div class="metrics-grid mb-4">
      <div class="metric-card">
        <i class="ti ti-droplet"></i>
        <div class="metric-val" id="m-humidity">–</div>
        <div class="metric-lbl">Humidity</div>
      </div>
      <div class="metric-card">
        <i class="ti ti-wind"></i>
        <div class="metric-val" id="m-wind">–</div>
        <div class="metric-lbl">Wind</div>
      </div>
      <div class="metric-card">
        <i class="ti ti-sun"></i>
        <div class="metric-val" id="m-uv">–</div>
        <div class="metric-lbl">UV Index</div>
      </div>
      <div class="metric-card">
        <i class="ti ti-eye"></i>
        <div class="metric-val" id="m-visibility">–</div>
        <div class="metric-lbl">Visibility</div>
      </div>
    </div>

    <div class="section-title">Hourly forecast</div>
    <div class="hourly-strip" id="hourly-strip"></div>

    <div class="section-title">Shade coverage by time of day</div>
    <div class="mb-4">
      <div class="shade-bar-row">
        <span class="shade-bar-label">Morning</span>
        <div class="shade-bar-track"><div class="shade-bar-fill" id="bar-morning"></div></div>
        <span class="shade-bar-pct" id="pct-morning">–</span>
      </div>
      <div class="shade-bar-row">
        <span class="shade-bar-label">Midday</span>
        <div class="shade-bar-track"><div class="shade-bar-fill" id="bar-midday"></div></div>
        <span class="shade-bar-pct" id="pct-midday">–</span>
      </div>
      <div class="shade-bar-row">
        <span class="shade-bar-label">Afternoon</span>
        <div class="shade-bar-track"><div class="shade-bar-fill" id="bar-afternoon"></div></div>
        <span class="shade-bar-pct" id="pct-afternoon">–</span>
      </div>
      <div class="shade-bar-row">
        <span class="shade-bar-label">Evening</span>
        <div class="shade-bar-track"><div class="shade-bar-fill" id="bar-evening"></div></div>
        <span class="shade-bar-pct" id="pct-evening">–</span>
      </div>
    </div>

    <div class="shade-alert" id="shade-alert" style="display:none;">
      <i class="ti ti-sun-high"></i>
      <div id="shade-alert-text"></div>
    </div>

    <div class="section-title">Nearby shady trails</div>
    <div id="trails-list">
      <div class="trail-card">
        <div class="trail-icon"><i class="ti ti-trees"></i></div>
        <div class="trail-info">
          <div class="trail-name">Redwood Grove Loop</div>
          <div class="trail-meta">3.2 km · 45 min · 0.4 km away</div>
        </div>
        <span class="badge-shade-high">High shade</span>
      </div>
      <div class="trail-card">
        <div class="trail-icon"><i class="ti ti-ripple"></i></div>
        <div class="trail-info">
          <div class="trail-name">Creekside Greenway</div>
          <div class="trail-meta">5.8 km · 1.2 hr · 1.1 km away</div>
        </div>
        <span class="badge-shade-high">High shade</span>
      </div>
      <div class="trail-card">
        <div class="trail-icon"><i class="ti ti-leaf"></i></div>
        <div class="trail-info">
          <div class="trail-name">Meadow Ridge Path</div>
          <div class="trail-meta">2.1 km · 30 min · 1.8 km away</div>
        </div>
        <span class="badge-shade-med">Moderate shade</span>
      </div>
    </div>

  </div><%# end #weather-content %>
</div><%# end .container %>

<script>
  const WMO_CODES = {
    0:  { label: 'Clear Sky',     icon: 'ti-sun' },
    1:  { label: 'Mainly Clear',  icon: 'ti-sun' },
    2:  { label: 'Partly Cloudy', icon: 'ti-cloud-sun' },
    3:  { label: 'Overcast',      icon: 'ti-cloud' },
    45: { label: 'Foggy',         icon: 'ti-cloud-fog' },
    48: { label: 'Icy Fog',       icon: 'ti-cloud-fog' },
    51: { label: 'Light Drizzle', icon: 'ti-cloud-drizzle' },
    53: { label: 'Drizzle',       icon: 'ti-cloud-drizzle' },
    55: { label: 'Heavy Drizzle', icon: 'ti-cloud-drizzle' },
    61: { label: 'Light Rain',    icon: 'ti-cloud-rain' },
    63: { label: 'Rain',          icon: 'ti-cloud-rain' },
    65: { label: 'Heavy Rain',    icon: 'ti-cloud-rain' },
    71: { label: 'Light Snow',    icon: 'ti-snowflake' },
    73: { label: 'Snow',          icon: 'ti-snowflake' },
    75: { label: 'Heavy Snow',    icon: 'ti-snowflake' },
    80: { label: 'Showers',       icon: 'ti-cloud-rain' },
    81: { label: 'Heavy Showers', icon: 'ti-cloud-storm' },
    95: { label: 'Thunderstorm',  icon: 'ti-cloud-storm' },
    99: { label: 'Hail Storm',    icon: 'ti-cloud-storm' },
  };

  function getWmo(code) {
    return WMO_CODES[code] || { label: 'Unknown', icon: 'ti-cloud' };
  }

  function calcShadeScore(wmoCode, uvIndex) {
    let cloudShade = 0;
    if (wmoCode <= 1)       cloudShade = 5;
    else if (wmoCode === 2) cloudShade = 45;
    else if (wmoCode === 3) cloudShade = 70;
    else                    cloudShade = 80;
    const uvShade = Math.max(0, Math.round(100 - (uvIndex / 11) * 80));
    return Math.min(100, Math.round((cloudShade * 0.5) + (uvShade * 0.5)));
  }

  function shadeClass(score) {
    if (score >= 65) return 'high';
    if (score >= 40) return 'medium';
    return 'low';
  }

  function shadeCaption(score) {
    if (score >= 65) return 'Good shade<br>conditions';
    if (score >= 40) return 'Moderate shade<br>conditions';
    return 'Low shade<br>today';
  }

  function barColor(score) {
    if (score >= 65) return '#3b6d11';
    if (score >= 40) return '#ba7517';
    return '#c0392b';
  }

  function fmtHour(isoStr) {
    const h = new Date(isoStr).getHours();
    if (h === 0)  return '12 AM';
    if (h === 12) return '12 PM';
    return h < 12 ? `${h} AM` : `${h - 12} PM`;
  }

  async function reverseGeocode(lat, lon) {
    try {
      const r = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`);
      const d = await r.json();
      const city    = d.address.city || d.address.town || d.address.village || d.address.county || 'Your Location';
      const state   = d.address.state_code || d.address.state || '';
      const country = d.address.country_code ? d.address.country_code.toUpperCase() : '';
      return `${city}${state ? ', ' + state : ''}${country && country !== 'US' ? ', ' + country : ''}`;
    } catch {
      return `${lat.toFixed(2)}°N, ${lon.toFixed(2)}°W`;
    }
  }

  async function fetchWeather() {
    document.getElementById('weather-loading').style.display = 'block';
    document.getElementById('weather-error').style.display   = 'none';
    document.getElementById('weather-content').style.display = 'none';

    let lat, lon;
    try {
      const pos = await new Promise((res, rej) =>
        navigator.geolocation.getCurrentPosition(res, rej, { timeout: 8000 })
      );
      lat = pos.coords.latitude;
      lon = pos.coords.longitude;
    } catch {
      // Default: Surrey, BC
      lat = 49.19;
      lon = -122.85;
    }

    try {
      const url =
        `https://api.open-meteo.com/v1/forecast` +
        `?latitude=${lat}&longitude=${lon}` +
        `&current=temperature_2m,apparent_temperature,weather_code,` +
        `wind_speed_10m,relative_humidity_2m,uv_index,visibility` +
        `&hourly=temperature_2m,weather_code,uv_index` +
        `&daily=temperature_2m_max,temperature_2m_min` +
        `&timezone=auto&forecast_days=1`;

      const res  = await fetch(url);
      const data = await res.json();
      renderWeather(data, lat, lon);
    } catch (err) {
      console.error(err);
      document.getElementById('weather-loading').style.display = 'none';
      document.getElementById('weather-error').style.display   = 'block';
    }
  }

  async function renderWeather(data, lat, lon) {
    const cur  = data.current;
    const hrly = data.hourly;
    const dly  = data.daily;
    const now  = new Date();

    const locationName = await reverseGeocode(lat, lon);
    document.getElementById('location-name').textContent = locationName;
    document.getElementById('location-sub').textContent  =
      `Updated ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    document.getElementById('location-date').textContent =
      now.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });

    const wmo = getWmo(cur.weather_code);
    document.getElementById('condition-icon').className    = `ti ${wmo.icon}`;
    document.getElementById('condition-text').textContent  = wmo.label;
    document.getElementById('temp-display').innerHTML      = `${Math.round(cur.temperature_2m)}<sup>°C</sup>`;
    document.getElementById('feels-like').textContent      =
      `Feels like ${Math.round(cur.apparent_temperature)}° · High ${Math.round(dly.temperature_2m_max[0])}° · Low ${Math.round(dly.temperature_2m_min[0])}°`;

    const score = calcShadeScore(cur.weather_code, cur.uv_index ?? 0);
    const cls   = shadeClass(score);
    document.getElementById('shade-ring').className    = `shade-ring shade-${cls}`;
    document.getElementById('shade-score').className   = `shade-ring-num shade-${cls}`;
    document.getElementById('shade-score').textContent = score;
    document.getElementById('shade-caption').innerHTML = shadeCaption(score);

    document.getElementById('m-humidity').textContent   = `${cur.relative_humidity_2m}%`;
    document.getElementById('m-wind').textContent       = `${Math.round(cur.wind_speed_10m)} km/h`;
    document.getElementById('m-uv').textContent         = `UV ${Math.round(cur.uv_index ?? 0)}`;
    document.getElementById('m-visibility').textContent = `${Math.round((cur.visibility ?? 0) / 1000)} km`;

    const times      = hrly.time;
    const startIdx   = times.findIndex(t => new Date(t).getHours() === now.getHours());
    const sliceStart = startIdx >= 0 ? startIdx : 0;
    const strip      = document.getElementById('hourly-strip');
    strip.innerHTML  = '';

    times.slice(sliceStart, sliceStart + 6).forEach((t, i) => {
      const idx        = sliceStart + i;
      const temp       = Math.round(hrly.temperature_2m[idx]);
      const wmoH       = getWmo(hrly.weather_code[idx]);
      const uvH        = hrly.uv_index ? hrly.uv_index[idx] : 0;
      const shadeH     = calcShadeScore(hrly.weather_code[idx], uvH);
      const shadeEmoji = shadeH >= 65 ? '🌿' : shadeH >= 40 ? '⛅' : '☀️';
      strip.innerHTML +=
        `<div class="hour-card${i === 0 ? ' now' : ''}">
          <div class="hour-time">${i === 0 ? 'Now' : fmtHour(t)}</div>
          <i class="ti ${wmoH.icon}"></i>
          <div class="hour-temp">${temp}°</div>
          <div class="hour-shade">${shadeEmoji} ${shadeH}%</div>
        </div>`;
    });

    function avgShadeForWindow(startH, endH) {
      const indices = times.reduce((acc, t, i) => {
        const h = new Date(t).getHours();
        if (h >= startH && h < endH) acc.push(i);
        return acc;
      }, []);
      if (!indices.length) return 50;
      const scores = indices.map(i =>
        calcShadeScore(hrly.weather_code[i], hrly.uv_index ? hrly.uv_index[i] : 0)
      );
      return Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
    }

    const windows = [
      { id: 'morning',   start: 6,  end: 12 },
      { id: 'midday',    start: 12, end: 14 },
      { id: 'afternoon', start: 14, end: 18 },
      { id: 'evening',   start: 18, end: 22 },
    ];

    let lowestWindow = null;
    let lowestScore  = 100;

    windows.forEach(({ id, start, end }) => {
      const s = avgShadeForWindow(start, end);
      document.getElementById(`bar-${id}`).style.width      = `${s}%`;
      document.getElementById(`bar-${id}`).style.background = barColor(s);
      document.getElementById(`pct-${id}`).textContent      = `${s}%`;
      if (s < lowestScore) { lowestScore = s; lowestWindow = id; }
    });

    if (lowestScore < 55) {
      const labels = {
        morning:   'Morning (6 AM–12 PM)',
        midday:    'Midday (12–2 PM)',
        afternoon: 'Afternoon (2–6 PM)',
        evening:   'Evening (6–10 PM)',
      };
      document.getElementById('shade-alert-text').innerHTML =
        `<strong>Low shade during ${labels[lowestWindow]}</strong>` +
        `Shade coverage drops to ${lowestScore}% during this window. ` +
        `Consider trails with dense tree cover, or visit during a shadier time of day.`;
      document.getElementById('shade-alert').style.display = 'flex';
    }

    document.getElementById('weather-loading').style.display = 'none';
    document.getElementById('weather-content').style.display = 'block';
  }

  fetchWeather();
</script>

