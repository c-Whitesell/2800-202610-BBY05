<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShadyTrails</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css" />
  <%- typeof styles !=='undefined' ? styles : '' %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">

    <script>
      window.TUTORIAL_MODE = <%= typeof tutorialMode !== 'undefined' ? tutorialMode : true %>;
    </script>
</head>

<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <nav class="st-navbar" id="st-navbar">
    <a class="st-navbar__brand" href="/">
      <div class="st-navbar__brand-icon">🌲</div>
      ShadyTrails
    </a>
    <ul class="st-navbar__links">
      <li><a href="/" class="<%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>">Home</a>
      </li>
      <li><a href="/map"
          class="<%= typeof activePage !== 'undefined' && activePage === 'map' ? 'active' : '' %>">Explore</a></li>
      <li><a href="/weather"
          class="<%= typeof activePage !== 'undefined' && activePage === 'weather' ? 'active' : '' %>">Weather</a>
      </li>
      <li><a href="/recommendations"
          class="<%= typeof activePage !== 'undefined' && activePage === 'recommendations' ? 'active' : '' %>">Trails</a>
      </li>
      <li><a href="/bookmarks"
          class="<%= typeof activePage !== 'undefined' && activePage === 'bookmarks' ? 'active' : '' %>">Bookmarks</a>
      </li>
      <li><a href="/search"
          class="<%= typeof activePage !== 'undefined' && activePage === 'search' ? 'active' : '' %>">Search</a>
      </li>
      <li><a href="/settings"
          class="<%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>">Settings</a>
      </li>
      <li><a href="/profile"
          class="<%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'active' : '' %>">Profile</a>
      </li>
       <li><a href="/dashboard"
          class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      </li>
         <li><a href="/admin"
          class="<%= typeof activePage !== 'undefined' && activePage === 'admin' ? 'active' : '' %>">Admin Page</a>
      </li>
    </ul>
    <div class="st-navbar__actions">
      <% if (isAuthenticated) { %>
        <a href="/" class="st-btn st-btn--primary st-btn--sm">Home</a>
         <a href="/logout" class="st-btn st-btn--primary st-btn--sm">Log out</a>
        <% } else { %>
          <a href="/login" class="st-btn st-btn--ghost st-btn--sm">Sign In</a>
          <a href="/signup" class="st-btn st-btn--primary st-btn--sm">Get Started</a>
          <% } %>
    </div>
  </nav>
  <script>
    window.addEventListener('scroll', function () {
      var nav = document.getElementById('st-navbar');
      if (window.scrollY > 40) { nav.classList.add('scrolled'); }
      else { nav.classList.remove('scrolled'); }
    });
  </script>