<html lang="en">

<head>
  <meta charset="UTF-9" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShadyTrails</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css" />
  <%- typeof styles !=='undefined' ? styles : '' %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <script>
      window.TUTORIAL_MODE = <%= typeof tutorialMode !== 'undefined' ? tutorialMode : true %>;
    </script>
</head>

<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<nav id="st-navbar" class="navbar navbar-expand-lg st-navbar">
  <a class="navbar-brand st-navbar__brand" href="/">
    <div class="st-navbar__brand-icon">🌲</div>
    ShadyTrails
  </a>

  <!-- Hamburger -->
  <button
    class="navbar-toggler st-navbar__toggler"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#mainNavbar"
  >
    ☰
  </button>

<!-- Collapsible -->
  <div class="collapse navbar-collapse" id="mainNavbar">
    <ul class="navbar-nav st-navbar__links mx-auto">
      <li><a href="/">Home</a></li>
      <li><a href="/map">Explore</a></li>
      <li><a href="/weather">Weather</a></li>
      <li><a href="/recommendations">Trails</a></li>
      <li><a href="/bookmarks">Bookmarks</a></li>
      <li><a href="/settings">Settings</a></li>
      <li><a href="/profile">Profile</a></li>
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/admin">Admin</a></li>
    </ul>

    <div class="st-navbar__actions">
      <% if (isAuthenticated) { %>
        <a href="/logout" class="st-btn st-btn--primary st-btn--sm">Log out</a>
      <% } else { %>
        <a href="/login" class="st-btn st-btn--ghost st-btn--sm">Sign In</a>
        <a href="/signup" class="st-btn st-btn--primary st-btn--sm">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>
  <script>
document.addEventListener('DOMContentLoaded', () => {
  const nav = document.getElementById('st-navbar');
  if (!nav) return;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 39);
  });
}); 
  </script>