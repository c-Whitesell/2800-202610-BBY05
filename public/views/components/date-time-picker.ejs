<!-- 1. The Scroller Navbar (Changes color) -->
<nav class="st-time-navbar" id="navbar">
  <div class="timeline-wrapper">
    <div class="selection-indicator"></div>
    <div class="timeline-axis" id="timeline"></div>
  </div>
</nav>

<!-- 2. The Information Section (Frosted Glass Card Active) -->
<div class="st-content-header">
  <div class="st-time-focus">
    <div id="celestialTop"></div>
    <h1 class="current-time-display" id="currentTimeDisplay">12:00 PM</h1>
  </div>

  <div class="date-navigator">
    <button class="nav-arrow" id="prevDay">❮</button>
    <div class="date-input-wrapper">
      <span id="dateLabel"></span>
      <input type="date" id="hiddenDatePicker" />
    </div>
    <button class="nav-arrow" id="nextDay">❯</button>
  </div>

  <div id="timezoneLabel" class="st-tz-text"></div>
  <button class="now-btn" id="btnNow" style="display: none">BACK TO NOW</button>
</div>

<style>
  :root {
    --accent: #2563eb;
    --text-muted: #94a3b8;
    --text-main: #1e293b;
  }

  body,
  html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: sans-serif;
  }

  #map {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
    z-index: 0;
  }

  .st-time-navbar {
    position: fixed;
    top: 68px;
    left: 0;
    width: 100%;
    height: 75px;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.8s ease;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  /* Modified Information Card Section with Active Frosted Glass Properties */
  .st-content-header {
    position: absolute;
    top: 163px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999; /* Boosted so it lays over all map interaction layer panels safely */
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;

    /* Active Frosted Glass Card Design Styles */
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    padding: 16px 32px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 32px rgba(15, 23, 42, 0.15);
    pointer-events: none;
  }

  .st-time-navbar.dark-mode {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .st-time-navbar.dark-mode .time-marker {
    color: rgba(255, 255, 255, 0.7);
  }

  .st-time-navbar.dark-mode .marker-icon {
    color: #ffffff;
  }

  .st-time-focus,
  .date-navigator,
  .now-btn {
    pointer-events: auto;
  }

  .timeline-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    pointer-events: auto;
  }

  .timeline-axis {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    cursor: grab;
    height: 60px;
    align-items: center;
  }

  /* Note: Removed mask-image styling block to prevent layout clipping problems on the card container layout elements */
  .timeline-axis::-webkit-scrollbar {
    display: none;
  }
  .time-marker {
    flex: 0 0 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.7rem;
    font-weight: bold;
    color: var(--text-muted);
  }
  .marker-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .marker-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
  }
  .current-time-display {
    font-size: 3.2rem; /* Sized down slightly for elegant spacing within the card layout container */
    margin: 0;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--text-main);
  }
  .date-navigator {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 10px;
  }
  .now-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 30px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 5px;
  }

  .st-time-navbar,
  .st-content-header {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  .nav-arrow,
  .now-btn,
  .timeline-axis {
    -webkit-tap-highlight-color: transparent;
  }

  .marker-icon,
  #celestialTop {
    pointer-events: none;
    user-drag: none;
    -webkit-user-drag: none;
  }
</style>

<script>
  const timeline = document.getElementById("timeline");
  const timeDisplay = document.getElementById("currentTimeDisplay");
  const dateLabel = document.getElementById("dateLabel");
  const dateInput = document.getElementById("hiddenDatePicker");
  const timezoneLabel = document.getElementById("timezoneLabel");
  const btnNow = document.getElementById("btnNow");
  const celestialTop = document.getElementById("celestialTop");
  const navbar = document.getElementById("navbar");

  const hours = 24,
    markerWidth = 120,
    totalWidth = hours * markerWidth;
  let currentSelectedDate = new Date();
  let lastHourIndex = -1;

  // ── Debouncer Logic Variables ───────────────────────────
  let shadeDebounceTimeout = null;

  const SVGS = {
    sunrise: `<svg viewBox="0 0 24 24"><path d="M17 18a5 5 0 0 0-10 0M12 2v7M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M23 22H1M8 6l4-4 4 4"/></svg>`,
    sunset: `<svg viewBox="0 0 24 24"><path d="M17 18a5 5 0 0 0-10 0M12 9V2M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M23 22H1M16 5l-4 4-4-4"/></svg>`,
    moons: ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"],
  };

  function getCelestialData(date) {
    const dayOfYear = Math.floor(
      (date - new Date(date.getFullYear(), 0, 0)) / 86400000,
    );
    const sunrise = 6 - Math.sin((2 * Math.PI * (dayOfYear - 80)) / 365) * 1.5;
    const sunset = 18.5 + Math.sin((2 * Math.PI * (dayOfYear - 80)) / 365) * 2;
    const lp = 2551443,
      newMoon = new Date(2000, 0, 6, 18, 14, 0);
    const phaseIndex = Math.floor(
      ((((date.getTime() - newMoon.getTime()) / 1000) % lp) / lp) * 8,
    );
    return { sunrise, sunset, moon: SVGS.moons[phaseIndex] };
  }

  function updateNavbarPalette(decimalHour) {
    const { sunrise, sunset, moon } = getCelestialData(currentSelectedDate);
    let bg = "rgba(255, 255, 255, 0.2)";
    let isDay = decimalHour >= sunrise && decimalHour <= sunset;

    navbar.classList.remove("dark-mode");

    if (decimalHour > sunrise - 1 && decimalHour < sunrise + 1) {
      bg =
        "linear-gradient(to right, rgba(255, 126, 95, 0.6), rgba(254, 180, 123, 0.6))";
    } else if (decimalHour >= sunrise + 1 && decimalHour <= sunset - 1) {
      bg = "rgba(125, 211, 252, 0.4)";
    } else if (decimalHour > sunset - 1 && decimalHour < sunset + 1) {
      bg =
        "linear-gradient(to right, rgba(249, 115, 22, 0.6), rgba(76, 29, 149, 0.6))";
      navbar.classList.add("dark-mode");
    } else if (!isDay) {
      bg = "rgba(15, 23, 42, 0.7)";
      navbar.classList.add("dark-mode");
    }

    navbar.style.background = bg;
    celestialTop.innerHTML = isDay ? "☀️" : moon;
  }

  function refreshTimeline() {
    timeline.innerHTML = "";
    const { sunrise, sunset, moon } = getCelestialData(currentSelectedDate);
    for (let i = 0; i < 3; i++) {
      const frag = document.createDocumentFragment();
      for (let h = 0; h < 24; h++) {
        const div = document.createElement("div");
        div.className = "time-marker";
        let icon = h >= sunrise && h <= sunset ? "☀️" : moon;
        if (Math.abs(h - sunrise) < 0.6) icon = SVGS.sunrise;
        if (Math.abs(h - sunset) < 0.6) icon = SVGS.sunset;
        div.innerHTML = `<div class="marker-icon">${icon}</div><span>${h % 12 || 12}${h < 12 ? "am" : "pm"}</span>`;
        frag.appendChild(div);
      }
      timeline.appendChild(frag);
    }
  }

  function updateDisplay() {
    dateLabel.textContent = currentSelectedDate.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
    const y = currentSelectedDate.getFullYear(),
      m = String(currentSelectedDate.getMonth() + 1).padStart(2, "0"),
      d = String(currentSelectedDate.getDate()).padStart(2, "0");
    dateInput.value = `${y}-${m}-${d}`;
    refreshTimeline();
    triggerShadeCalculationDebounce(); // Update shade when date skips
  }

  // Extract precise state values from UI components
  function getSelectedDateTimeObject() {
    const textStr = timeDisplay.textContent; // Format Example "7:20 PM" or "12:00 AM"
    const match = textStr.match(/(\d+):(\d+)\s+(AM|PM)/i);
    let hoursVal = 12;
    let minutesVal = 0;

    if (match) {
      hoursVal = parseInt(match[1], 10);
      minutesVal = parseInt(match[2], 10);
      const ampm = match[3].toUpperCase();
      if (ampm === "PM" && hoursVal < 12) hoursVal += 12;
      if (ampm === "AM" && hoursVal === 12) hoursVal = 0;
    }

    const combinedDate = new Date(currentSelectedDate);
    combinedDate.setHours(hoursVal, minutesVal, 0, 0);
    return combinedDate;
  }

  // 3-Second Delay Debouncer Action Handler
  function triggerShadeCalculationDebounce() {
    clearTimeout(shadeDebounceTimeout);
    shadeDebounceTimeout = setTimeout(async () => {
      const activeDateTime = getSelectedDateTimeObject();

      // Dispatch Event to map framework script listener
      const event = new CustomEvent("dateTimeTimelineChanged", {
        detail: { timestamp: activeDateTime.toISOString() },
      });
      window.dispatchEvent(event);
    }, 3000);
  }

  timeline.addEventListener("scroll", () => {
    if (timeline.scrollLeft >= totalWidth * 2)
      timeline.scrollLeft -= totalWidth;
    if (timeline.scrollLeft <= totalWidth - markerWidth)
      timeline.scrollLeft += totalWidth;

    const decimal =
      ((timeline.scrollLeft + timeline.offsetWidth / 2) % totalWidth) /
      markerWidth;
    const h = Math.floor(decimal),
      m = Math.round(((decimal - h) * 60) / 10) * 10;

    timeDisplay.textContent = `${h % 12 || 12}:${String(m == 60 ? 0 : m).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`;
    updateNavbarPalette(decimal);

    if (lastHourIndex !== -1 && lastHourIndex !== h) {
      if (lastHourIndex === 23 && h === 0) {
        currentSelectedDate.setDate(currentSelectedDate.getDate() + 1);
        updateDisplay();
      } else if (lastHourIndex === 0 && h === 23) {
        currentSelectedDate.setDate(currentSelectedDate.getDate() - 1);
        updateDisplay();
      }
    }
    lastHourIndex = h;

    const now = new Date();
    btnNow.style.display =
      currentSelectedDate.toDateString() !== now.toDateString() ||
      Math.abs(decimal - (now.getHours() + now.getMinutes() / 60)) > 0.5
        ? "block"
        : "none";

    triggerShadeCalculationDebounce(); // Trigger debounce timer on wheel scroll interactions
  });

  // Handle Event Responses from DB syncing the closest timestamp back to slider UI
  window.addEventListener("syncTimelineUIToTime", (e) => {
    const synchronizedDate = new Date(e.detail.adjustedTimestamp);
    currentSelectedDate = new Date(
      synchronizedDate.getFullYear(),
      synchronizedDate.getMonth(),
      synchronizedDate.getDate(),
    );

    // Lock updating display loops securely
    dateLabel.textContent = currentSelectedDate.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
    const y = synchronizedDate.getFullYear(),
      m = String(synchronizedDate.getMonth() + 1).padStart(2, "0"),
      d = String(synchronizedDate.getDate()).padStart(2, "0");
    dateInput.value = `${y}-${m}-${d}`;
    refreshTimeline();

    const h = synchronizedDate.getHours();
    const mins = synchronizedDate.getMinutes();
    timeDisplay.textContent = `${h % 12 || 12}:${String(mins).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`;

    // Reposition scroll coordinate context smoothly matching exact match tracking index positions
    const decimalTarget = h + mins / 60;
    timeline.scrollLeft =
      totalWidth + decimalTarget * markerWidth - timeline.offsetWidth / 2;
    updateNavbarPalette(decimalTarget);
    lastHourIndex = h;
  });

  // Drag Interactivity handlers
  let isDown = false,
    startX,
    scrollL;
  timeline.onmousedown = (e) => {
    isDown = true;
    startX = e.pageX - timeline.offsetLeft;
    scrollL = timeline.scrollLeft;
  };
  window.onmouseup = () => (isDown = false);
  timeline.onmousemove = (e) => {
    if (!isDown) return;
    timeline.scrollLeft =
      scrollL - (e.pageX - timeline.offsetLeft - startX) * 1.5;
  };

  document.getElementById("prevDay").onclick = () => {
    currentSelectedDate.setDate(currentSelectedDate.getDate() - 1);
    updateDisplay();
  };
  document.getElementById("nextDay").onclick = () => {
    currentSelectedDate.setDate(currentSelectedDate.getDate() + 1);
    updateDisplay();
  };
  btnNow.onclick = () => {
    const n = new Date();
    currentSelectedDate = new Date(n.getFullYear(), n.getMonth(), n.getDate());
    updateDisplay();
    timeline.scrollTo({
      left:
        totalWidth +
        (n.getHours() + n.getMinutes() / 60) * markerWidth -
        timeline.offsetWidth / 2,
      behavior: "smooth",
    });
  };
  dateInput.oninput = (e) => {
    currentSelectedDate = new Date(e.target.value + "T00:00:00");
    updateDisplay();
  };

  // Init
  const init = new Date();
  updateDisplay();
  timeline.scrollLeft =
    totalWidth +
    (init.getHours() + init.getMinutes() / 60) * markerWidth -
    window.innerWidth / 2;
  timezoneLabel.textContent = `${Intl.DateTimeFormat().resolvedOptions().timeZone} (UTC${-init.getTimezoneOffset() / 60 >= 0 ? "+" : ""}${-init.getTimezoneOffset() / 60})`;
</script>
