<!-- Fullscreen Halloween Jump Scare Overlay Container -->
<div id="halloweenScareOverlay" class="scare-overlay">
  <img
    src="https://mediaproxy.tvtropes.org/width/1200/https://static.tvtropes.org/pmwiki/pub/images/reganmacneil.png"
    alt="Scare"
  />
</div>

<!-- 1. The Scroller Navbar (Changes color) -->
<nav class="st-time-navbar" id="navbar">
  <div class="timeline-wrapper">
    <div class="selection-indicator"></div>
    <div class="timeline-axis" id="timeline"></div>
  </div>
</nav>

<!-- 2. The Information Section (Frosted Glass Card Active) -->
<div class="st-content-header">
  <div class="st-time-focus">
    <div id="celestialTop"></div>
    <h1 class="current-time-display" id="currentTimeDisplay">12:00 PM</h1>
  </div>

  <div class="date-navigator">
    <button class="nav-arrow" id="prevDay">❮</button>
    <div class="date-input-wrapper">
      <span id="dateLabel"></span>
      <input type="date" id="hiddenDatePicker" />
    </div>
    <button class="nav-arrow" id="nextDay">❯</button>
  </div>

  <div id="timezoneLabel" class="st-tz-text"></div>
  <button class="now-btn" id="btnNow" style="display: none">BACK TO NOW</button>
</div>

<style>
  :root {
    --accent: #2563eb;
    --text-muted: #94a3b8;
    --text-main: #1e293b;
  }

  body,
  html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: sans-serif;
  }

  #map {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
    z-index: 0;
  }

  .st-time-navbar {
    position: fixed;
    top: 68px;
    left: 0;
    width: 100%;
    height: 75px;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.8s ease;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  /* Modified Information Card Section with Active Frosted Glass Properties */
  .st-content-header {
    position: absolute;
    top: 163px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999; /* Boosted so it lays over all map interaction layer panels safely */
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;

    /* Active Frosted Glass Card Design Styles */
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    padding: 16px 32px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 32px rgba(15, 23, 42, 0.15);
    pointer-events: none;
  }

  .st-time-navbar.dark-mode {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .st-time-navbar.dark-mode .time-marker {
    color: rgba(255, 255, 255, 0.7);
  }

  .st-time-navbar.dark-mode .marker-icon {
    color: #ffffff;
  }

  /* Modified to display inline using flexbox */
  .st-time-focus {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 12px; /* Space between emoji and time */
    pointer-events: auto;
  }

  .date-navigator,
  .now-btn {
    pointer-events: auto;
  }

  .timeline-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    pointer-events: auto;
  }

  .timeline-axis {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    cursor: grab;
    height: 60px;
    align-items: center;
  }

  .timeline-axis::-webkit-scrollbar {
    display: none;
  }
  .time-marker {
    flex: 0 0 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.7rem;
    font-weight: bold;
    color: var(--text-muted);
  }
  .marker-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .marker-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
  }

  #celestialTop {
    font-size: 2.8rem; /* Matches time font closely */
    line-height: 1;
    pointer-events: none;
    user-drag: none;
    -webkit-user-drag: none;
  }

  .current-time-display {
    font-size: 3.2rem;
    margin: 0;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--text-main);
  }
  .date-navigator {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 10px;
  }

  .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--text-main);
  }

  .date-input-wrapper {
    position: relative;
    font-weight: bold;
    color: var(--text-main);
  }

  #hiddenDatePicker {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .now-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 30px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 5px;
  }

  .st-time-navbar,
  .st-content-header {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  .nav-arrow,
  .now-btn,
  .timeline-axis {
    -webkit-tap-highlight-color: transparent;
  }

  /* --- MOBILE MEDIA QUERY (Significantly Smaller) --- */
  @media (max-width: 768px) {
    .st-content-header {
      padding: 8px 16px; /* Tighter padding overall */
      border-radius: 12px; /* Smaller rounding to match */
      width: max-content; /* Hug the internal elements instead of stretching to 85% */
      max-width: 90%;
      top: 152px;
    }

    .st-time-focus {
      gap: 6px; /* Tighter gap between emoji and time */
    }

    .current-time-display {
      font-size: 1.6rem; /* Much smaller time text */
    }

    #celestialTop {
      font-size: 1.4rem; /* Scaled down emoji to match time */
    }

    .date-navigator {
      gap: 10px; /* Bring arrows closer to the date */
      margin-bottom: 4px;
      font-size: 0.85rem; /* Smaller date font */
    }

    .nav-arrow {
      font-size: 0.85rem; /* Smaller arrows */
    }

    #timezoneLabel {
      font-size: 0.65rem; /* Very small timezone font */
    }

    .now-btn {
      padding: 4px 12px; /* Much smaller button area */
      font-size: 0.65rem; /* Tiny text for the button */
      margin-top: 4px;
    }
  }

  /* Fullscreen fixed jump scare layer overlay properties */
  .scare-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #000000;
    z-index: 999999; /* Higher than map layers and time navbar controls */
    display: none; /* Hidden by default until triggered */
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .scare-overlay img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Forces the image to completely fill the screen viewport dimensions */
    user-select: none;
    -webkit-user-drag: none;
  }
</style>

<script>
  /**
   * timeline.js
   * Manages the interactive date-time timeline, celestial-based UI themes,
   * and date navigation for the application.
   */

  const timeline = document.getElementById("timeline");
  const timeDisplay = document.getElementById("currentTimeDisplay");
  const dateLabel = document.getElementById("dateLabel");
  const dateInput = document.getElementById("hiddenDatePicker");
  const timezoneLabel = document.getElementById("timezoneLabel");
  const btnNow = document.getElementById("btnNow");
  const celestialTop = document.getElementById("celestialTop");
  const navbar = document.getElementById("navbar");

  const hours = 24,
    markerWidth = 120,
    totalWidth = hours * markerWidth;

  let currentSelectedDate = new Date();
  let lastHourIndex = -1;
  let shadeDebounceTimeout = null;

  const SVGS = {
    sunrise: `<svg viewBox="0 0 24 24"><path d="M17 18a5 5 0 0 0-10 0M12 2v7M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M23 22H1M8 6l4-4 4 4"/></svg>`,
    sunset: `<svg viewBox="0 0 24 24"><path d="M17 18a5 5 0 0 0-10 0M12 9V2M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M23 22H1M16 5l-4 4-4-4"/></svg>`,
    moons: ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"],
  };

  /**
   * Calculates sunrise, sunset, and lunar phase for a given date.
   * @param {Date} date - The date to calculate celestial data for.
   * @returns {Object} Sunrise hour, sunset hour, and moon icon.
   */
  function getCelestialData(date) {
    const dayOfYear = Math.floor(
      (date - new Date(date.getFullYear(), 0, 0)) / 86400000,
    );
    const sunrise = 6 - Math.sin((2 * Math.PI * (dayOfYear - 80)) / 365) * 1.5;
    const sunset = 18.5 + Math.sin((2 * Math.PI * (dayOfYear - 80)) / 365) * 2;
    const lp = 2551443,
      newMoon = new Date(2000, 0, 6, 18, 14, 0);
    const phaseIndex = Math.floor(
      ((((date.getTime() - newMoon.getTime()) / 1000) % lp) / lp) * 8,
    );
    return { sunrise, sunset, moon: SVGS.moons[phaseIndex] };
  }

  /**
   * Updates navbar background and celestial icon based on time of day.
   * @param {number} decimalHour - The current hour as a decimal.
   */
  function updateNavbarPalette(decimalHour) {
    const { sunrise, sunset, moon } = getCelestialData(currentSelectedDate);
    let bg = "rgba(255, 255, 255, 0.2)";
    let isDay = decimalHour >= sunrise && decimalHour <= sunset;

    navbar.classList.remove("dark-mode");

    if (decimalHour > sunrise - 1 && decimalHour < sunrise + 1) {
      bg =
        "linear-gradient(to right, rgba(255, 126, 95, 0.6), rgba(254, 180, 123, 0.6))";
    } else if (decimalHour >= sunrise + 1 && decimalHour <= sunset - 1) {
      bg = "rgba(125, 211, 252, 0.4)";
    } else if (decimalHour > sunset - 1 && decimalHour < sunset + 1) {
      bg =
        "linear-gradient(to right, rgba(249, 115, 22, 0.6), rgba(76, 29, 149, 0.6))";
      navbar.classList.add("dark-mode");
    } else if (!isDay) {
      bg = "rgba(15, 23, 42, 0.7)";
      navbar.classList.add("dark-mode");
    }

    navbar.style.background = bg;
    celestialTop.innerHTML = isDay ? "☀️" : moon;
  }

  /**
   * Regenerates the timeline UI markers based on the selected date.
   */
  function refreshTimeline() {
    timeline.innerHTML = "";
    const { sunrise, sunset, moon } = getCelestialData(currentSelectedDate);
    for (let i = 0; i < 3; i++) {
      const frag = document.createDocumentFragment();
      for (let h = 0; h < 24; h++) {
        const div = document.createElement("div");
        div.className = "time-marker";
        let icon = h >= sunrise && h <= sunset ? "☀️" : moon;
        if (Math.abs(h - sunrise) < 0.6) icon = SVGS.sunrise;
        if (Math.abs(h - sunset) < 0.6) icon = SVGS.sunset;
        div.innerHTML = `<div class="marker-icon">${icon}</div><span>${h % 12 || 12}${h < 12 ? "am" : "pm"}</span>`;
        frag.appendChild(div);
      }
      timeline.appendChild(frag);
    }
  }

  /**
   * Updates UI labels and triggers external shade recalculations.
   */
  function updateDisplay() {
    dateLabel.textContent = currentSelectedDate.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
    const y = currentSelectedDate.getFullYear(),
      m = String(currentSelectedDate.getMonth() + 1).padStart(2, "0"),
      d = String(currentSelectedDate.getDate()).padStart(2, "0");
    dateInput.value = `${y}-${m}-${d}`;
    refreshTimeline();
    triggerShadeCalculationDebounce();

    if (
      currentSelectedDate.getMonth() === 9 &&
      currentSelectedDate.getDate() === 31
    ) {
      const scareTriggeredBefore = localStorage.getItem(
        "halloweenScareEncountered",
      );

      if (!scareTriggeredBefore) {
        localStorage.setItem("halloweenScareEncountered", "true");
        const overlay = document.getElementById("halloweenScareOverlay");
        const scareAudio = new Audio(
          "https://audio.com/gutali-jgpt/audio/scary-maze-game-scream-sound-quicksoundscom",
        );
        scareAudio.volume = 1.0;
        scareAudio
          .play()
          .catch((err) => console.log("Audio autoplay prevented:", err));
        overlay.style.display = "flex";
        setTimeout(() => {
          overlay.style.display = "none";
          scareAudio.pause();
        }, 3000);
      }
    }
  }

  /**
   * Parses the current time text display into a Date object.
   * @returns {Date} Date object reflecting the selected timeline time.
   */
  function getSelectedDateTimeObject() {
    const textStr = timeDisplay.textContent;
    const match = textStr.match(/(\d+):(\d+)\s+(AM|PM)/i);
    let hoursVal = 12;
    let minutesVal = 0;

    if (match) {
      hoursVal = parseInt(match[1], 10);
      minutesVal = parseInt(match[2], 10);
      const ampm = match[3].toUpperCase();
      if (ampm === "PM" && hoursVal < 12) hoursVal += 12;
      if (ampm === "AM" && hoursVal === 12) hoursVal = 0;
    }

    const combinedDate = new Date(currentSelectedDate);
    combinedDate.setHours(hoursVal, minutesVal, 0, 0);
    return combinedDate;
  }

  /**
   * Debounces shade calculation event dispatching to optimize performance.
   */
  function triggerShadeCalculationDebounce() {
    clearTimeout(shadeDebounceTimeout);
    shadeDebounceTimeout = setTimeout(async () => {
      const activeDateTime = getSelectedDateTimeObject();
      const event = new CustomEvent("dateTimeTimelineChanged", {
        detail: { timestamp: activeDateTime.toISOString() },
      });
      window.dispatchEvent(event);
    }, 3000);
  }

  // Event Listeners for UI interaction
  timeline.addEventListener("scroll", () => {
    if (timeline.scrollLeft >= totalWidth * 2)
      timeline.scrollLeft -= totalWidth;
    if (timeline.scrollLeft <= totalWidth - markerWidth)
      timeline.scrollLeft += totalWidth;

    const decimal =
      ((timeline.scrollLeft + timeline.offsetWidth / 2) % totalWidth) /
      markerWidth;
    const h = Math.floor(decimal),
      m = Math.round(((decimal - h) * 60) / 10) * 10;

    timeDisplay.textContent = `${h % 12 || 12}:${String(m == 60 ? 0 : m).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`;
    updateNavbarPalette(decimal);

    if (lastHourIndex !== -1 && lastHourIndex !== h) {
      if (lastHourIndex === 23 && h === 0) {
        currentSelectedDate.setDate(currentSelectedDate.getDate() + 1);
        updateDisplay();
      } else if (lastHourIndex === 0 && h === 23) {
        currentSelectedDate.setDate(currentSelectedDate.getDate() - 1);
        updateDisplay();
      }
    }
    lastHourIndex = h;

    const now = new Date();
    btnNow.style.display =
      currentSelectedDate.toDateString() !== now.toDateString() ||
      Math.abs(decimal - (now.getHours() + now.getMinutes() / 60)) > 0.15
        ? "block"
        : "none";

    triggerShadeCalculationDebounce();
  });

  let isDown = false,
    startX,
    scrollL;
  timeline.onmousedown = (e) => {
    isDown = true;
    startX = e.pageX - timeline.offsetLeft;
    scrollL = timeline.scrollLeft;
  };
  window.onmouseup = () => (isDown = false);
  timeline.onmousemove = (e) => {
    if (!isDown) return;
    timeline.scrollLeft =
      scrollL - (e.pageX - timeline.offsetLeft - startX) * 1.5;
  };

  document.getElementById("prevDay").onclick = () => {
    currentSelectedDate.setDate(currentSelectedDate.getDate() - 1);
    updateDisplay();
  };
  document.getElementById("nextDay").onclick = () => {
    currentSelectedDate.setDate(currentSelectedDate.getDate() + 1);
    updateDisplay();
  };
  btnNow.onclick = () => {
    const n = new Date();
    const decimalNow = n.getHours() + n.getMinutes() / 60;
    timeline.scrollTo({
      left: totalWidth + decimalNow * markerWidth - timeline.offsetWidth / 2,
      behavior: "smooth",
    });

    setTimeout(() => {
      currentSelectedDate = new Date(
        n.getFullYear(),
        n.getMonth(),
        n.getDate(),
      );
      updateDisplay();
      btnNow.style.display = "none";
    }, 1000);
  };

  // Initial state setup
  const init = new Date();
  updateDisplay();
  timeline.scrollLeft =
    totalWidth +
    (init.getHours() + init.getMinutes() / 60) * markerWidth -
    window.innerWidth / 2;
  timezoneLabel.textContent = `${Intl.DateTimeFormat().resolvedOptions().timeZone} (UTC${-init.getTimezoneOffset() / 60 >= 0 ? "+" : ""}${-init.getTimezoneOffset() / 60})`;
</script>
