<%- include('components/header', { 
  title: 'Map',
  styles: `
    <link rel="stylesheet" href="/css/bookmarks.css" />
  `
  }) %>

<div class="page-wrapper bookmarks-wrapper">
    <main class="container bookmarks-page">
        <!-- Page header -->
        <div class="p-4 p-md-5 mb-4 bg-body-tertiary rounded-3">
            <div class="container-fluid py-3">
                <h1 class="display-6 fw-bold mb-2">My Bookmarks</h1>
                <p class="col-md-8 fs-5 mb-0">
                    View all the posts you’ve saved for later.
                </p>
            </div>
        </div>

        <!-- loading state -->
        <div id="bookmarksLoading" class="text-center py-5">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <p class="mt-3 mb-0">Loading your bookmarks...</p>
        </div>

        <!-- Empty state -->
        <div id="bookmarksEmpty" class="d-none text-center py-5">
            <i class="bi bi-bookmark fs-1"></i>
            <h2 class="h4 mt-3">No bookmarks yet</h2>
            <p class="text-muted">Save posts to view them here later.</p>
            <a href="/" class="btn btn-primary">Browse Posts</a>
        </div>

        <!-- Bookmarks list -->
        <div id="bookmarksSection" class="d-none">
            <div class="row mb-3">
                <div class="col">
                    <h2 class="h4">Saved Posts</h2>
                </div>
            </div>

            <div id="bookmarksContainer" class="row g-4">
                <!-- JS will insert bookmarked posts here -->
            </div>
        </div>
    </main>
<%- include('components/footer') %>
</div>