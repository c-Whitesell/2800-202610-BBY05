<%- include('components/header', { 
  title: 'Bookmarks',
  styles: `
    <link rel="stylesheet" href="/css/bookmarks.css" />
  `
  }) %>


<div class="bookmarks-wrapper">
<main class="container bookmarks-page">

    <div class="st-page-header p-4 p-md-5 mb-4 rounded-3">
        <div class="container-fluid py-3">
            <h1 class="display-6 fw-bold mb-2">My Bookmarks</h1>
            <p class="col-md-8 fs-5 mb-0">
                View all the parks and paths you've saved for later.
            </p>
        </div>
    </div>
       <% if (isAuthenticated) { %>

        <!-- Loading state -->
        <div id="bookmarksLoading" class="text-center py-5">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <p class="mt-3 mb-0">Loading your bookmarks...</p>
        </div>

        <!-- Empty state -->
        <div id="bookmarksEmpty" class="d-none text-center py-5">
            <i class="bi bi-bookmark fs-1"></i>
            <h2 class="h4 mt-3">No bookmarks yet</h2>
            <p class="text-muted">Save parks and paths to view them here later.</p>
            <a href="/recommendations" class="btn btn-primary">Browse Trails</a>
        </div>

        <!-- Bookmarks grid -->
        <div id="bookmarksSection" class="d-none">
            <div class="row mb-3 align-items-center">
                <div class="col">
                    <h2 class="h4 mb-0">Saved Places</h2>
                </div>
                <div class="col-auto">
                    <span id="bookmarksCount" class="badge bg-secondary"></span>
                </div>
            </div>

            <div id="bookmarksContainer" class="rec-grid">
                <!-- JS inserts cards here -->
            </div>
        </div>

    <% } else { %>

        <div class="p-5 mb-4 bg-body-tertiary rounded-3">
            <div class="container-fluid py-5">
                <h3 class="display-5 fw-bold">You must be logged in to view your bookmarks.</h3>
                <p class="col-md-8 fs-4"></p>
                <a href="/login" class="st-btn st-btn--ghost st-btn--sm">Sign In</a>
            </div>
        </div>

    <% } %>

</main>
<%- include('components/footer') %>
<script src="/js/bookmarks.js"></script>
</div>